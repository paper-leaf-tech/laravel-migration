{
  "name": "paper-leaf-tech/laravel-migration",
  "description": "A package to manage Laravel Migrations",
  "license": "MIT",
  "authors": [
    {
      "name": "Brendan Angerman",
      "email": "brendan@paper-leaf.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/queue": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.92"
  },
  "autoload": {
    "psr-4": {
      "PaperleafTech\\LaravelMigration\\": "src"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PaperleafTech\\LaravelMigration\\LaravelMigrationServiceProvider"
      ]
    }
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "PaperleafTech\\LaravelMigration\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
